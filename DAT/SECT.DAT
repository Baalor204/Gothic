"+Spotting"          "0     0     1     0     1     0     0     0     1"
"+Camouflage"        "0     1     0     1     0     0     0     0     0"
"+Agility"           "0     1     0     0     0     0     1     1     0"
"*Armor"             "0    10    10    10     0    10    10    10     0"
"*Psy Defense"       "0     0     0    50    50     0    10     0    50"
"+Accuracy"          "0     0     1     0     0     1     0     0     1"
"*Attack Strength"   "0     0     0     0    10    10     0    10     0"
}
