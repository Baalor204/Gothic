"+Healing Rate"      "0    10     0     0     0     0    10    10     5"
"+Plague"            "0   -10     0     0     0     0     0   -50   -25"
"+Experience"        "10    0    10     0     0    10    10     0     0"
"+Routing"           "0     0     0    10    10    10     0     0     0"
"+Rebellion"         "0     0     0    10     0     0     0     0     0"
"+Loyalty"           "10    0     0     0    10     0     0     0     0"
"+Ruin"              "0     0     0     0     0     0     0     0     0"
"*Upkeep"            "0     0   -10     0     0     0     0     0     0"
}
//
